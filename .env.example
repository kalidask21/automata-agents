# Ollama — used by apps/api ONLY (the browser never talks to Ollama directly).
# Ollama exposes an OpenAI-compatible API; the server points the openai SDK at it.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_API_KEY is ignored by Ollama but the SDK needs a non-empty string.
OLLAMA_API_KEY=ollama

# API server port (the web app's Vite dev server proxies /api and /ws here).
API_PORT=3001
